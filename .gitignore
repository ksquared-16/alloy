# Node
node_modules/
**/node_modules/
# Slash-less too: the patterns above match DIRECTORIES only, so a *symlink* named
# node_modules was not ignored and `git add -A` committed one pointing into another
# worktree (staging 52e2d0947). These catch that shape.
node_modules
**/node_modules

# Vercel
.vercel/
**/.vercel/

web/.next/

# Generated / cache
*.tsbuildinfo
.DS_Store
web/test-results/

# Local handoff artifacts
*.bundle

# Local SQL dumps / baselines at repo root only
/*.sql

# Communications WIP artifacts should live on comms/* branches, not staging
/comunications_wip/
/communications_wip/
/UI*.md
/THREAD_SEMANTICS.md
/Messaging_*.md
/SMS_*.md
/comms-v2-*
/communications-v2-*

# Local scoped typecheck helper (not product code)
web/tsconfig.poscheck.json
