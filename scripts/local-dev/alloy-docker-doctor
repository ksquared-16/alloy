#!/usr/bin/env bash
# Diagnose / recover local Docker for managed Alloy workers.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/docker-ops.sh
source "${SCRIPT_DIR}/lib/docker-ops.sh"

usage() {
  cat <<'EOF'
Usage: alloy-docker-doctor [--recover] [--force]

Diagnose Docker for managed workers (Claude/Cursor slots).

  (default)   print DOCKER_STATUS=ok|missing|unreachable|wedged
  --recover   quit + relaunch Docker Desktop (macOS) and wait until ready
  --force     if still hung after quit, SIGKILL Desktop helpers then relaunch
              (use when Docker is wedged and needs the force-kill path)

Workers must not invent their own Docker kill loops — use this command.

Examples:
  alloy-docker-doctor
  alloy-docker-doctor --recover
  alloy-docker-doctor --recover --force
EOF
}

main() {
  local recover=0 force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --recover) recover=1; shift ;;
      --force) force=1; recover=1; shift ;;
      *) alloy_die "unknown option: $1" ;;
    esac
  done

  echo "Alloy Docker doctor"
  echo "-------------------"
  local rc=0
  alloy_docker_health_report || rc=$?

  if [[ "$recover" -eq 0 ]]; then
    if [[ "$rc" -eq 0 ]]; then
      echo "OK — Docker is healthy."
      exit 0
    fi
    echo "NOT OK — run: alloy-docker-doctor --recover"
    echo "If still hung: alloy-docker-doctor --recover --force"
    exit "$rc"
  fi

  alloy_docker_recover_desktop "$force"
  alloy_docker_health_report
  alloy_docker_is_ok
}

main "$@"
