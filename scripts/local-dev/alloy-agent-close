#!/usr/bin/env bash
# Close a managed Alloy agent session: stop server + git summary. Never removes worktree.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/agent.sh
source "${SCRIPT_DIR}/lib/agent.sh"

usage() {
  cat <<'EOF'
Usage: alloy-agent-close <worktree-name|slot>

Stops the owned dev server (if any), marks the agent closed, and prints a git
summary. Never removes the worktree, branch, or metadata.

Examples:
  alloy-agent-close 3
  alloy-agent-close wt3-queue-perf
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }

  alloy_load_config
  alloy_ensure_agent_runtime_dirs

  local name
  name="$(alloy_resolve_worktree_name "$1")"
  alloy_load_metadata "$name"

  local slot="$ALLOY_WORKTREE_SLOT"
  local role="${ALLOY_AGENT_ROLE:-$(alloy_slot_role "$slot")}"
  local path="$ALLOY_WORKTREE_PATH"

  alloy_info "Stopping owned server for ${name} (if running)..."
  env ALLOY_CONFIG_FILE="${ALLOY_CONFIG_FILE}" \
    "${SCRIPT_DIR}/alloy-dev-stop" "$name" || true

  alloy_set_agent_status "$name" "closed"
  alloy_load_metadata "$name"

  cat <<EOF

Agent closed (worktree preserved)
  slot:     ${slot}
  role:     ${role}
  agent:    ${ALLOY_AGENT}
  worktree: ${name}
  path:     ${path}
  port:     ${PORT}
  server:   $(alloy_server_state_for "$name")
  status:   ${ALLOY_AGENT_STATUS}

EOF

  alloy_print_git_summary_detail "$path"

  cat <<EOF

Worktree was NOT removed.
To reopen later:
  alloy-agent-open ${slot}
To remove only after human review:
  alloy-worktree-remove ${name}
EOF
}

main "$@"
