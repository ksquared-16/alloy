#!/usr/bin/env bash
# Stop toolkit-owned browser for a managed agent slot only.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/agent.sh
source "${SCRIPT_DIR}/lib/agent.sh"
# shellcheck source=lib/verify.sh
source "${SCRIPT_DIR}/lib/verify.sh"

usage() {
  cat <<'EOF'
Usage: alloy-agent-browser-stop <slot|name>

Stops only the browser process owned by this managed slot.
Never kills global Chrome, Safari, Cursor, or unrelated sessions.
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }

  alloy_load_config
  alloy_ensure_verify_runtime_dirs

  local name
  name="$(alloy_resolve_worktree_name "$1")"
  alloy_load_metadata "$name"

  alloy_stop_owned_browser "$ALLOY_WORKTREE_SLOT"
  printf 'browser state: %s\n' "$(alloy_browser_state_for "$ALLOY_WORKTREE_SLOT")"
}

main "$@"
