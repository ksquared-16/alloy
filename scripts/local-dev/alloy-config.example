# Alloy local parallel-agent development toolkit — example config
# Installed copy (never overwritten by install.sh):
#   ~/.config/alloy-dev/config
#
# Paths are configurable. Defaults match the Phase 1 directory model.

ALLOY_REPO="$HOME/Alloy"
ALLOY_WORKTREE_ROOT="$HOME/Code/alloy-worktrees"
ALLOY_RUNTIME_ROOT="$HOME/.local/state/alloy-dev"
ALLOY_CONFIG_DIR="$HOME/.config/alloy-dev"
ALLOY_BIN_DIR="$HOME/bin/alloy-dev"

ALLOY_BASE_REMOTE="origin"
ALLOY_BASE_BRANCH="staging"

# Exact canonical-repo identity (opt-in).
#
# When set, alloy_verify_canonical_repo REFUSES an ALLOY_REPO whose remote does
# not match this URL. scp-style and https forms of the same remote compare equal.
# When unset, the toolkit falls back to a name heuristic and says so — it warns,
# it does not verify.
#
# Left unset by default because the certification harness and test fixtures point
# ALLOY_REPO at synthetic repositories with local remotes. Set it in your
# installed config (~/.config/alloy-dev/config) to make identity enforced:
#
#   ALLOY_REPO_EXPECTED_REMOTE="git@github.com:ksquared-16/alloy.git"
#
# Note this checks WHICH REPOSITORY, not WHICH CLONE — two clones of Alloy share
# one remote. Ambient root identity is answered by alloy-root, not by this.
ALLOY_REPO_EXPECTED_REMOTE="${ALLOY_REPO_EXPECTED_REMOTE:-}"

# Canonical staging app on the main checkout; agent slots use 3011–3016.
ALLOY_CANONICAL_PORT="3000"
ALLOY_FIRST_AGENT_PORT="3011"
ALLOY_MAX_AGENTS="6"

# Permanent slot identities (Phase 2). Slots keep these roles across initiatives.
# alloy-agent-create uses DEFAULT_AGENT when cursor|claude is omitted.
ALLOY_SLOT_1_ROLE="Product implementation"
ALLOY_SLOT_1_DEFAULT_AGENT="cursor"
ALLOY_SLOT_2_ROLE="Architecture / doctrine"
ALLOY_SLOT_2_DEFAULT_AGENT="claude"
ALLOY_SLOT_3_ROLE="Performance"
ALLOY_SLOT_3_DEFAULT_AGENT="cursor"
ALLOY_SLOT_4_ROLE="UI / UX"
ALLOY_SLOT_4_DEFAULT_AGENT="cursor"
ALLOY_SLOT_5_ROLE="Refactor / infrastructure"
ALLOY_SLOT_5_DEFAULT_AGENT="claude"
ALLOY_SLOT_6_ROLE="Experimental"
ALLOY_SLOT_6_DEFAULT_AGENT="cursor"

# Per-slot QA identities — MANAGED MACHINE ACCOUNTS in hosted staging, not mailboxes.
#
# These addresses are the real identities, not placeholders to replace: they are machine
# identifiers that receive no mail and that no human signs in as. Leave them as shipped unless a
# slot should point at a different managed QA account.
#
# They are created by the governed action `environment.provision_qa_identity` and signed in by
# `environment.restore_qa_session` — two separate operator approvals, because creating an account
# and signing into one are different decisions. Never put a password here; none is created for a
# person to hold. See VERIFICATION-SECURITY.md.
ALLOY_SLOT_1_QA_IDENTITY="qa-slot1-product@example.com"
ALLOY_SLOT_2_QA_IDENTITY="qa-slot2-architecture@example.com"
ALLOY_SLOT_3_QA_IDENTITY="qa-slot3-performance@example.com"
ALLOY_SLOT_4_QA_IDENTITY="qa-slot4-ui@example.com"
ALLOY_SLOT_5_QA_IDENTITY="qa-slot5-refactor@example.com"
ALLOY_SLOT_6_QA_IDENTITY="qa-slot6-experimental@example.com"

# Safe env bootstrap (alloy-agent-prepare) — agent-visible sanitized file only.
ALLOY_ENV_SOURCE="$ALLOY_REPO/web/.env.local"
# Extra allowlisted non-secret names (space-separated). Denylist always wins.
# NEXT_PUBLIC_* allowed after denylist pass. Built-in: PORT, NODE_ENV, NEXT_PUBLIC_APP_URL, ALLOY_AGENT_ENV.
ALLOY_ENV_ALLOWLIST="DEV_QUEUE_ORG_ID PLAYWRIGHT_BASE_URL"
# Set to 1 to refuse remote Supabase URLs in agent env.
ALLOY_BLOCK_REMOTE_SUPABASE="0"

# Trusted server env — injected only into toolkit-owned Next process by alloy-dev-start.
# Never copied into the worktree. Distinct from ALLOY_ENV_SOURCE.
ALLOY_SERVER_ENV_SOURCE="$ALLOY_REPO/web/.env.local"
# Optional extra required server variable names (space-separated). Built-in minimum: SUPABASE_SERVICE_ROLE_KEY.
ALLOY_SERVER_ENV_REQUIRED=""

# Auth routes (discovered: Supabase email/password at /login).
ALLOY_AGENT_LOGIN_ROUTE="/login"
ALLOY_AGENT_AUTH_CHECK_ROUTE="/workspace"
# Optional extra hosts for verify allowlist (space-separated hostnames).
ALLOY_VERIFY_ALLOWED_HOSTS=""

# App package lives under web/ (npm + package-lock.json).
ALLOY_PM="npm"
ALLOY_WEB_DIR="web"
ALLOY_DEV_COMMAND="npm run dev"
# Production server for `alloy-dev-start --production`. Same trusted-env injection, different
# command; the build is a separate operation and the server never builds implicitly.
ALLOY_PROD_COMMAND="npm run start"

# Heavy validation runs from ALLOY_WEB_DIR inside the worktree.
# These commands are invoked BY the broker — never `npm run typecheck|build|test`
# (those package scripts route INTO the broker; using them here would recurse).
ALLOY_TYPECHECK_COMMAND='node --max-old-space-size=8192 node_modules/typescript/bin/tsc -p tsconfig.build.json --noEmit'
ALLOY_TYPECHECK_TESTS_COMMAND='node --max-old-space-size=8192 node_modules/typescript/bin/tsc -p tsconfig.json --noEmit'
# Leave EMPTY. The broker builds the vitest command from what the installed CLI actually accepts
# (lib/validate-caps.sh probes `vitest run --help`). Hardcoding worker flags here is what broke
# `vac run test`: vitest 4.x rejects --minWorkers, so every brokered test run died with
# `CACError: Unknown option --minWorkers` before running a test. Set this only to override the
# whole command, and do not put worker flags in it.
ALLOY_TEST_COMMAND=''
# Worker cap the broker applies when the installed vitest supports it.
ALLOY_TEST_MAX_WORKERS='2'
ALLOY_BUILD_COMMAND='npx next build'
ALLOY_PLAYWRIGHT_COMMAND='npx playwright test --workers=1'
# Canonical import verification for the web package:
ALLOY_IMPORTS_COMMAND='npm run verify:module-imports'

# Default Node heap for alloy-dev-start and alloy-validate wrappers.
NODE_OPTIONS_DEFAULT="--max-old-space-size=8192"

# Cleanup age thresholds (hours) for generated artifacts only.
ALLOY_CLEAN_ARTIFACT_AGE_HOURS="24"

# Validation lease polling (seconds) and heartbeat stale threshold.
ALLOY_VALIDATE_POLL_SECONDS="5"
ALLOY_VALIDATE_HEARTBEAT_STALE_SECONDS="90"

# Managed Sprint Operations V1 — resource guardrails.
# Six assigned worktrees must not automatically mean six servers or six heavy jobs.
ALLOY_MAX_ACTIVE_PROVIDERS="3"
ALLOY_MAX_RUNNING_SERVERS="3"
ALLOY_MAX_CONCURRENT_INSTALLS="1"
ALLOY_MAX_CONCURRENT_HEAVY_JOBS="1"
# Runtime Resource Orchestration V1 — max concurrent backing-infrastructure
# runtimes (Supabase stacks). OBSERVATIONAL ONLY in Runtime Registry & Inspection
# V1: `alloy-ro runtime-capacity` reports over-budget status; nothing is blocked,
# stopped, or provisioned. Enforcement arrives in a later phase.
ALLOY_MAX_ACTIVE_RUNTIMES="2"
# When macOS memory pressure reaches this level, refuse/defer heavy work (never auto-kill workers).
# Values: warn | critical | off
ALLOY_MEMORY_PRESSURE_THRESHOLD="warn"

# Phase 4 — Engineering Manager initiatives (local state under ALLOY_RUNTIME_ROOT/initiatives/)
# ALLOY_INITIATIVE_LOCK_POLL_SECONDS="2"
