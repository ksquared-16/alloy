#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/product.sh
source "${SCRIPT_DIR}/lib/product.sh"

usage() {
  cat <<'EOF'
Usage:
  cat product-brief.yaml | alloy-product-import <key>

Imports a Product Brief from standard input into a new product initiative.

See: scripts/local-dev/PRODUCT-RUNTIME.md
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }

  local key="$1"
  alloy_load_config
  alloy_product_require_node
  alloy_initiative_key_valid "$key" || alloy_die "invalid product key: $key"

  local tmp
  tmp="$(mktemp)"
  cat >"$tmp"
  [[ -s "$tmp" ]] || alloy_die "no brief data on stdin"

  env ALLOY_CONFIG_FILE="${ALLOY_CONFIG_FILE}" \
    "${SCRIPT_DIR}/alloy-product-create" "$key" --from "$tmp"
  rm -f "$tmp"
}

main "$@"
