#!/usr/bin/env bash
# Print resolved Alloy runtime path names (never secrets).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: alloy-runtime-paths

Prints the resolved runtime root and derived path names for the active config.
Never prints secrets, credentials, or file contents.
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
  alloy_load_config
  alloy_runtime_paths_report
}

main "$@"
