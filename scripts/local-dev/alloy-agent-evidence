#!/usr/bin/env bash
# List verification evidence artifacts for a managed agent.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/agent.sh
source "${SCRIPT_DIR}/lib/agent.sh"
# shellcheck source=lib/verify.sh
source "${SCRIPT_DIR}/lib/verify.sh"

usage() {
  cat <<'EOF'
Usage: alloy-agent-evidence <slot|name>

Lists screenshots, traces, verification summaries under the slot evidence directory.
Reports file names, sizes, and modification times only — never file contents.
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }

  alloy_load_config
  alloy_ensure_verify_runtime_dirs

  local name
  name="$(alloy_resolve_worktree_name "$1")"
  alloy_load_metadata "$name"

  local dir
  dir="$(alloy_evidence_dir "$name")"
  echo "Evidence — ${name}"
  echo "  path: ${dir}"

  if [[ ! -d "$dir" ]]; then
    echo "  (empty — no evidence yet)"
    exit 0
  fi

  echo
  printf '  %-12s %-24s %s\n' "SIZE" "MODIFIED" "FILE"
  local f size mtime
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    size="$(alloy_path_size_human "$f")"
    mtime="$(alloy_file_mtime_human "$f")"
    printf '  %-12s %-24s %s\n' "$size" "$mtime" "$(basename "$f")"
  done < <(alloy_list_evidence "$name")

  echo
  echo "Total directory size: $(alloy_path_size_human "$dir")"
}

main "$@"
