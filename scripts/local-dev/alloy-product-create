#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/engineering.sh
source "${SCRIPT_DIR}/lib/engineering.sh"
# shellcheck source=lib/product.sh
source "${SCRIPT_DIR}/lib/product.sh"

usage() {
  cat <<'EOF'
Usage:
  alloy-product-create <key> --clipboard
  alloy-product-create <key> --from /path/to/product-brief.yaml

Creates a new product initiative from a Product Brief (YAML).
Validates required fields strictly. Does not overwrite existing product initiatives.

See: scripts/local-dev/PRODUCT-RUNTIME.md
EOF
}

import_brief() {
  local key="$1"
  local raw_path="$2"
  local content json_path base product_base

  if [[ ! -f "$raw_path" ]]; then
    alloy_die "brief file not found: $raw_path"
  fi

  content="$(cat "$raw_path")"
  if alloy_product_forbidden_patterns_in_content "$content"; then
    alloy_warn "brief contains shell-like tokens — treated as data only (never executed)"
  fi

  if alloy_product_exists "$key"; then
    alloy_die "product initiative already exists: $key (refusing silent overwrite)"
  fi

  mkdir -p "$(alloy_initiative_dir "$key")"
  alloy_product_init_dirs "$key"
  product_base="$(alloy_product_dir "$key")"
  cp "$raw_path" "$product_base/brief.yaml"
  json_path="$product_base/brief.json"
  alloy_yaml_to_json "$product_base/brief.yaml" "$json_path"

  local brief_key
  brief_key="$(node -e "console.log(require('${json_path}').product.key)")"
  if [[ "$brief_key" != "$key" ]]; then
    alloy_die "product.key '${brief_key}' does not match argument '${key}'"
  fi

  alloy_product_io validate-brief "$json_path"

  local title staging_sha state_json
  title="$(node -e "console.log(require('${json_path}').product.title)")"
  staging_sha="$(alloy_staging_sha)"
  state_json="$(node -e "
    console.log(JSON.stringify({
      key: '${key}',
      title: $(node -e "console.log(JSON.stringify(require('${json_path}').product.title))"),
      state: 'draft',
      revision: 1,
      created_at: '$(alloy_iso_now)',
      updated_at: '$(alloy_iso_now)',
      staging_baseline_sha: '${staging_sha}',
      approved_contract_hash: null,
      approver: null,
      approved_at: null,
      handoff_at: null,
      cost_summary: $(alloy_product_cost_summary_init),
      history: []
    }));
  ")"
  alloy_product_io write-json "$product_base/state.json" "$state_json"

  alloy_info "Product initiative created: $key"
  alloy_info "  path: $product_base"
  alloy_info "  state: draft"
  alloy_info "  staging baseline: ${staging_sha:0:12}"
  alloy_info ""
  alloy_info "Next: alloy-product-audit $key"
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
  [[ $# -ge 2 ]] || { usage >&2; exit 2; }

  local key="$1"
  shift
  alloy_load_config
  alloy_product_require_node
  alloy_initiative_key_valid "$key" || alloy_die "invalid product key: $key"

  local mode="" from_path="" tmp
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --clipboard) mode="clipboard"; shift ;;
      --from) [[ $# -ge 2 ]] || alloy_die "--from requires path"; from_path="$2"; mode="file"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) alloy_die "unknown option: $1" ;;
    esac
  done

  case "$mode" in
    clipboard)
      alloy_require_cmd pbpaste
      tmp="$(mktemp)"
      pbpaste >"$tmp"
      import_brief "$key" "$tmp"
      rm -f "$tmp"
      ;;
    file)
      import_brief "$key" "$from_path"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
