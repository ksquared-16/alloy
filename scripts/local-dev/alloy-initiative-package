#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/engineering.sh
source "${SCRIPT_DIR}/lib/engineering.sh"

usage() {
  cat <<'EOF'
Usage: alloy-initiative-package <initiative-key>

Produces the final human-readable review package under final/.
Never pushes or merges.

See: scripts/local-dev/ENGINEERING-MANAGER.md
EOF
}

# Reasons behind the classification, so the package explains itself rather than
# asserting a word.
#
# File-backed on purpose: classify_promotion is invoked in a command
# substitution, so a shell array mutated inside it would not survive the
# subshell. This mirrors the KEY=value channel alloy_agent_ready_evaluate uses.
CLASSIFY_REASONS_FILE="${CLASSIFY_REASONS_FILE:-${TMPDIR:-/tmp}/alloy-classify-reasons.$$}"
classify_reason() { printf '%s\n' "$1" >>"$CLASSIFY_REASONS_FILE"; }
classify_reasons_reset() { : >"$CLASSIFY_REASONS_FILE"; }
classify_reasons_count() {
  [[ -s "$CLASSIFY_REASONS_FILE" ]] || { printf '0'; return; }
  wc -l <"$CLASSIFY_REASONS_FILE" | tr -d ' '
}
classify_reasons_print() {
  [[ -s "$CLASSIFY_REASONS_FILE" ]] || return 0
  sed 's/^/- /' "$CLASSIFY_REASONS_FILE"
}

classify_promotion() {
  local key="$1"
  local base="$2"
  local blockers=0
  local risks_total=0
  classify_reasons_reset

  # An initiative with no tasks has produced no evidence. Absence of work is not
  # readiness.
  local task_count=0

  # Check tasks complete, and that each complete task carries its own evidence.
  #
  # A task's evidence depends on what kind of task it is:
  #   - an implementation task produces reports/<tid>-result.json
  #   - a review task produces reviews/<tid>-review.json (REVIEW-PIPELINE.md:
  #     "Default review task: task-002")
  # A complete task carrying NEITHER has claimed completion without evidence.
  local tid st rp rv n
  for tid in $(alloy_engineering_list_tasks "$key"); do
    task_count=$((task_count + 1))
    st="$(alloy_engineering_task_status "$(alloy_engineering_task_path "$key" "$tid")")"
    if [[ "$st" != "complete" ]]; then
      blockers=$((blockers + 1))
      classify_reason "task ${tid}: ${st} (not complete)"
      continue
    fi

    rp="${base}/reports/${tid}-result.json"
    rv="${base}/reviews/${tid}-review.json"

    if [[ -f "$rp" ]]; then
      # Fail closed on unassessable risk.
      #
      # Risk previously came from a hardcoded reports/task-001-result.json read
      # as `... || echo 1`, so a MISSING or unreadable report yielded risks=1 and
      # classified as READY_WITH_KNOWN_RISKS — strictly MORE promotable than the
      # truth. Absent evidence is not "one known risk"; it is an unassessable
      # claim. The hardcoding also meant multi-task initiatives were assessed
      # from one task's report, and an initiative without a task-001 always took
      # the fallback silently.
      n="$(node -e "
        const r = require('${rp}');
        const k = (r.risks || []).length;
        if (!Number.isInteger(k)) process.exit(1);
        console.log(k);
      " 2>/dev/null)" || n=""
      if [[ -z "$n" ]]; then
        blockers=$((blockers + 1))
        classify_reason "task ${tid}: result report unreadable — risk not assessable"
        continue
      fi
      risks_total=$((risks_total + n))
      [[ "$n" == "0" ]] || classify_reason "task ${tid}: ${n} risk(s) reported"
    elif [[ -f "$rv" ]]; then
      # A review task. Its verdict is assessed by the review gate below; it
      # contributes no implementation risk of its own.
      :
    else
      blockers=$((blockers + 1))
      classify_reason "task ${tid}: complete but carries no evidence (no reports/${tid}-result.json, no reviews/${tid}-review.json) — not assessable"
      continue
    fi
  done

  if [[ "$task_count" -eq 0 ]]; then
    blockers=$((blockers + 1))
    classify_reason "initiative has no tasks — nothing to assess"
  fi

  # Check completed final review. Advisory reviews never contribute to READY.
  local review_status="missing"
  if [[ -f "$base/reviews/task-002-review.json" ]]; then
    review_status="$(node -e "console.log(require('${base}/reviews/task-002-review.json').status)")"
    if [[ "$review_status" == "fail" || "$review_status" == "blocked" ]]; then
      blockers=$((blockers + 1))
      classify_reason "review task-002: ${review_status}"
    fi
  else
    blockers=$((blockers + 1))
    classify_reason "review task-002: missing (reviews/task-002-review.json)"
  fi
  local final_review_ready
  final_review_ready="$(node -e "
    const d = require('${base}/state.json');
    const reviews = Object.values(d.reviews || {});
    process.stdout.write(reviews.some(r =>
      r.mode === 'final' &&
      (r.status === 'pass' || r.status === 'pass_with_findings') &&
      r.contributes_to_ready === true
    ) ? 'yes' : 'no');
  ")"
  if [[ "$final_review_ready" != "yes" ]]; then
    blockers=$((blockers + 1))
    classify_reason "no completed final review contributing to READY (advisory reviews never promote)"
  fi

  local open_decisions
  open_decisions="$(alloy_engineering_human_decisions_count "$key")"
  if [[ "$open_decisions" != "0" ]]; then
    classify_reason "${open_decisions} open human decision(s)"
    echo "BLOCKED_ON_HUMAN_DECISION"
    return
  fi

  [[ "$blockers" -gt 0 ]] && echo "NOT_READY" && return

  # Every task's risk evidence was present and readable to reach this point.
  if [[ "$risks_total" -gt 0 ]]; then
    echo "READY_WITH_KNOWN_RISKS"
  else
    classify_reason "all tasks complete, all risk reports present and empty, final review passed"
    echo "READY"
  fi
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }

  local key="$1"
  alloy_load_config
  alloy_engineering_require_node
  alloy_initiative_exists "$key" || alloy_die "initiative not found: $key"

  local base final_dir pkg_path rec_class branch_map
  base="$(alloy_initiative_dir "$key")"
  final_dir="$base/final"
  mkdir -p "$final_dir"
  pkg_path="$final_dir/review-package.md"
  rec_class="$(classify_promotion "$key" "$base")"
  alloy_engineering_io validate-promotion-class "$rec_class"

  local state_json
  state_json="$(cat "$base/state.json")"

  {
    printf '# Final review package — %s\n\n' "$key"
    printf 'Generated: %s\n\n' "$(alloy_iso_now)"
    printf '## Approved objective\n\n'
    node -e "console.log(require('${base}/initiative.json').initiative.objective)"
    printf '\n## Approved specification hash\n\n'
    node -e "console.log(require('${base}/state.json').approved_spec_hash||'(not approved)')"
    printf '\n## Scope delivered\n\n'
    if [[ -f "$base/reports/task-001-result.json" ]]; then
      node -e "for (const f of (require('${base}/reports/task-001-result.json').files_changed||[])) console.log('- ' + f)"
    else
      printf '(no implementation report)\n'
    fi
    printf '\n## Tasks and statuses\n\n'
    local tid
    for tid in $(alloy_engineering_list_tasks "$key"); do
      printf -- '- %s: %s\n' "$tid" "$(alloy_engineering_task_status "$(alloy_engineering_task_path "$key" "$tid")")"
    done
    printf '\n## Branch / commit map\n\n'
    node -e "
      const d = require('${base}/state.json');
      for (const [tid, w] of Object.entries(d.workers||{})) {
        const r = (d.reports||{})[tid];
        console.log('- ' + tid + ': branch ' + w.branch + ' @ ' + (r?r.commit:'(no report)'));
      }
    " 2>/dev/null || true
    printf '\n## Acceptance results\n\n'
    [[ -f "$final_dir/acceptance-results.json" ]] && cat "$final_dir/acceptance-results.json" || printf '(run validation and ingest reports)\n'
    printf '\n## Review status\n\n'
    [[ -f "$base/reviews/task-002-review.json" ]] && \
      node -e "const r=require('${base}/reviews/task-002-review.json'); console.log(r.status, r.findings)" || printf '(pending)\n'
    printf '\n## Remediation history\n\n'
    printf 'Rounds: %s\n' "$(node -e "console.log(require('${base}/state.json').remediation_round||0)")"
    printf '\n## Cost summary\n\n'
    node -e "console.log(JSON.stringify(require('${base}/state.json').cost_summary,null,2))"
    printf '\n## Conclusion provenance\n\n'
    printf '### Evidence-backed\n\n'
    printf -- '- Staging baseline and repository paths: audit manifests.\n'
    printf -- '- Commit and changed files: ingested worker reports verified against fixture/local Git.\n'
    printf -- '- Review status: completed structured final review artifact.\n'
    printf -- '- Evidence paths: existence checks during report ingestion.\n'
    printf '\n### Deterministic template-generated\n\n'
    printf -- '- Task decomposition and worker-role recommendations are constrained V1 templates.\n'
    printf -- '- Suggested promotion commands are examples only and were not executed.\n'
    printf -- '- Candidate code/doc matches are bounded text-search results, not semantic conclusions.\n'
    printf '\n## Promotion recommendation\n\n'
    printf '**%s**\n\n' "$rec_class"
    printf '### Why this classification\n\n'
    if [[ "$(classify_reasons_count)" == "0" ]]; then
      printf -- '- (no findings recorded)\n'
    else
      classify_reasons_print
    fi
    printf '\nMissing evidence never softens this verdict: an absent or unreadable\n'
    printf 'result report classifies NOT_READY, never READY_WITH_KNOWN_RISKS.\n\n'
    printf '## Push / PR commands (NOT executed)\n\n'
    node -e "
      const d = require('${base}/state.json');
      const w = d.workers['task-001'];
      if (!w) { console.log('(no worker assignment)'); process.exit(0); }
      console.log('git -C ' + w.path + ' push -u origin ' + w.branch);
      console.log('gh pr create --base staging --head ' + w.branch);
    " 2>/dev/null || true
    printf '\n---\n\n'
    printf '**Push and merge still require explicit human approval.**\n'
  } >"$pkg_path"

  cat >"$final_dir/promotion-recommendation.md" <<EOF
classification: $rec_class
generated_at: "$(alloy_iso_now)"
push_merge_requires_approval: true
reasons:
$(if [[ "$(classify_reasons_count)" == "0" ]]; then printf '  - (none recorded)\n'; else classify_reasons_print | sed 's/^- /  - /'; fi)
EOF

  cat >"$final_dir/commit-map.md" <<EOF
# Commit map — $key

$(node -e "
  const d = require('${base}/state.json');
  for (const [tid, w] of Object.entries(d.workers||{})) {
    const r = (d.reports||{})[tid];
    console.log('## ' + tid);
    console.log('- worktree: ' + w.path);
    console.log('- branch: ' + w.branch);
    console.log('- commit: ' + (r?r.commit:'pending'));
    console.log('');
  }
" 2>/dev/null || echo "(no workers)")
EOF

  if [[ "$rec_class" == "READY" || "$rec_class" == "READY_WITH_KNOWN_RISKS" ]]; then
    local cur
    cur="$(alloy_initiative_current_state "$key")"
    if [[ "$cur" == "reviewing" || "$cur" == "remediation_required" ]]; then
      alloy_initiative_transition "$key" "merge_ready" 2>/dev/null || true
    fi
    alloy_initiative_transition "$key" "awaiting_promotion_approval" 2>/dev/null || true
  fi

  node -e "
    const fs = require('fs');
    const p = '${base}/state.json';
    const d = JSON.parse(fs.readFileSync(p,'utf8'));
    d.promotion = { classification: '${rec_class}', packaged_at: '$(alloy_iso_now)' };
    fs.writeFileSync(p, JSON.stringify(d, null, 2) + '\n');
  "

  alloy_info "Final package: $pkg_path"
  alloy_info "Recommendation: $rec_class"
}

main "$@"
