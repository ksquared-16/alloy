#!/usr/bin/env bash
# Concise daily health snapshot for Alloy parallel-agent work.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/lock.sh
source "${SCRIPT_DIR}/lib/lock.sh"

section() {
  printf '\n== %s ==\n' "$1"
}

main() {
  alloy_load_config
  alloy_ensure_runtime_dirs

  section "Memory / load"
  if alloy_have_cmd memory_pressure; then
    memory_pressure 2>/dev/null | head -n 20 || true
  else
    echo "memory_pressure unavailable"
  fi
  uptime 2>/dev/null || true
  if alloy_have_cmd vm_stat; then
    vm_stat 2>/dev/null | head -n 12 || true
  fi

  section "Disk"
  df -h / 2>/dev/null || true
  if [[ -d "${ALLOY_REPO:-}" ]]; then
    df -h "$ALLOY_REPO" 2>/dev/null || true
  fi
  if [[ -d "${ALLOY_WORKTREE_ROOT:-}" ]]; then
    df -h "$ALLOY_WORKTREE_ROOT" 2>/dev/null || true
    echo "worktree root: $ALLOY_WORKTREE_ROOT ($(alloy_dir_size "$ALLOY_WORKTREE_ROOT"))"
  fi

  section "Alloy dev servers"
  if [[ -x "${SCRIPT_DIR}/alloy-dev-status" ]]; then
    "${SCRIPT_DIR}/alloy-dev-status" || true
  fi

  section "Heavy validation lock"
  if alloy_validate_lock_held; then
    alloy_validate_print_owner
  else
    echo "free"
  fi

  section "Active validators"
  local validators
  validators="$(alloy_print_active_validators | head -n 30 || true)"
  if [[ -n "$validators" ]]; then
    printf '%s\n' "$validators"
  else
    echo "(none)"
  fi

  section "Top CPU"
  ps -arco pid,pcpu,pmem,comm 2>/dev/null | head -n 12 || \
    ps -axo pid,pcpu,pmem,comm 2>/dev/null | sort -nrk2 | head -n 12 || true

  section "Git worktrees"
  if [[ -d "${ALLOY_REPO:-}" ]]; then
    git -C "$ALLOY_REPO" worktree list 2>/dev/null || true
  else
    echo "ALLOY_REPO not configured/present: ${ALLOY_REPO:-}"
  fi

  section "Large generated dirs (sample)"
  local roots=()
  [[ -d "${ALLOY_REPO:-}" ]] && roots+=("$ALLOY_REPO")
  [[ -d "${ALLOY_WORKTREE_ROOT:-}" ]] && roots+=("$ALLOY_WORKTREE_ROOT")
  local r
  for r in "${roots[@]}"; do
    find "$r" -maxdepth 4 \( -name '.next' -o -name 'coverage' -o -name 'test-results' -o -name 'playwright-report' -o -name 'node_modules' \) -type d 2>/dev/null \
      | head -n 40 \
      | while IFS= read -r d; do
          printf '%8s  %s\n' "$(alloy_dir_size "$d")" "$d"
        done || true
  done

  section "Engineering Health"
  echo "For scored disk/Docker/cache/worktree recommendations:"
  echo "  alloy-engineering-doctor"
  echo "  alloy-engineering-doctor --json"
}

main "$@"
