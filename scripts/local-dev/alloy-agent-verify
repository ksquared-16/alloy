#!/usr/bin/env bash
# Focused UI verification for a managed agent slot.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/agent.sh
source "${SCRIPT_DIR}/lib/agent.sh"
# shellcheck source=lib/verify.sh
source "${SCRIPT_DIR}/lib/verify.sh"

usage() {
  cat <<'EOF'
Usage: alloy-agent-verify <slot|name> <target> [arg]

Targets:
  authenticated-home
  route <path>                 e.g. route /workspace
  focused-spec <playwright-path>  delegates to alloy-validate (serialized)

Uses assigned localhost, slot storage state, one worker.
Evidence written to ~/.local/state/alloy-dev/evidence/<worktree>/.
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  [[ $# -ge 2 ]] || { usage >&2; exit 2; }

  alloy_load_config
  alloy_ensure_verify_runtime_dirs
  ALLOY_LOCAL_DEV_ROOT="$SCRIPT_DIR"

  local target="$1"
  shift
  local name verify_target verify_arg=""
  name="$(alloy_resolve_worktree_name "$target")"
  verify_target="$1"
  shift || true
  [[ $# -gt 0 ]] && verify_arg="$1"

  alloy_load_metadata "$name"
  local slot="$ALLOY_WORKTREE_SLOT"
  local port="$PORT"
  local path="$ALLOY_WORKTREE_PATH"
  local web_dir base storage evidence auth server

  web_dir="$(alloy_web_dir_for "$path")"
  [[ -d "$web_dir" ]] || alloy_die "web directory missing: $web_dir"

  server="$(alloy_server_state_for "$name")"
  [[ "$server" == "running" ]] || alloy_die "dev server not running — alloy-dev-start $name"

  base="$(alloy_verify_url_for_slot "$port")"
  alloy_verify_host_allowed "$base" || alloy_die "host not allowed: $base"

  auth="$(alloy_auth_state_status "$slot" "$port")"
  case "$auth" in
    valid|present) ;;
    *) alloy_die "auth not ready ($auth) — alloy-agent-login $slot" ;;
  esac

  storage="$(alloy_auth_storage_path "$slot")"
  [[ -f "$storage" ]] || alloy_die "storage state missing: $storage"

  evidence="$(alloy_evidence_dir "$name")"
  mkdir -p "$evidence"

  if [[ "$verify_target" == "focused-spec" ]]; then
    [[ -n "$verify_arg" ]] || alloy_die "focused-spec requires a playwright test path"
    alloy_info "Delegating full Playwright to alloy-validate (serialized lock)..."
    exec env ALLOY_CONFIG_FILE="${ALLOY_CONFIG_FILE}" \
      "${SCRIPT_DIR}/alloy-validate" "$name" command -- \
      npx playwright test "$verify_arg" --workers=1
  fi

  alloy_refuse_duplicate_browser "$slot"

  local -a node_args=(--base-url "$base" --storage "$storage" --evidence "$evidence")
  local -a pos_args=("$verify_target")
  [[ -n "$verify_arg" ]] && pos_args+=("$verify_arg")

  local verify_script="${ALLOY_AGENT_VERIFY_SCRIPT:-${SCRIPT_DIR}/lib/agent-verify.mjs}"
  local rc=0
  (
    cd "$web_dir"
    node "$verify_script" "${node_args[@]}" -- "${pos_args[@]}"
  ) || rc=$?

  exit "$rc"
}

main "$@"
