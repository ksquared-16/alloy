#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/engineering.sh
source "${SCRIPT_DIR}/lib/engineering.sh"
# shellcheck source=lib/product.sh
source "${SCRIPT_DIR}/lib/product.sh"
# shellcheck source=lib/agent.sh
source "${SCRIPT_DIR}/lib/agent.sh"

usage() {
  cat <<'EOF'
Usage:
  alloy-initiative-start <initiative-key> [--dry-run]

Creates managed workers via alloy-agent-create, writes worker packages,
and transitions to implementing.

Transitions: approved → assigning → implementing
EOF
}

main() {
  if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then usage; exit 0; fi
  [[ $# -ge 1 ]] || { usage >&2; exit 2; }

  local key="$1"
  shift
  local dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) alloy_die "unknown option: $1" ;;
    esac
  done

  alloy_load_config
  alloy_engineering_require_node
  alloy_initiative_exists "$key" || alloy_die "initiative not found: $key"

  alloy_initiative_acquire_lock "$key"
  local state
  state="$(alloy_initiative_current_state "$key")"
  [[ "$state" == "approved" || "$state" == "assigning" || "$state" == "remediation_required" ]] \
    || alloy_die "cannot start in state: $state"

  [[ -n "$(node -e "const d=require('$(alloy_initiative_dir "$key")/state.json'); process.stdout.write(d.approved_spec_hash||'');")" ]] \
    || alloy_die "initiative not approved — run alloy-initiative-approve first"

  if alloy_product_exists "$key"; then
    local pstate
    pstate="$(alloy_product_current_state "$key")"
    [[ "$pstate" == "handed_off" || "$pstate" == "closed" ]] \
      || alloy_die "Product Runtime not handed off (state: $pstate) — run alloy-product-handoff first"
  fi

  local base
  base="$(alloy_initiative_dir "$key")"
  if [[ -f "$base/product-handoff.json" ]]; then
    [[ -n "$(node -e "const d=require('${base}/state.json'); process.stdout.write(d.product_contract_hash||d.approved_product_contract_hash||'');")" ]] \
      || alloy_die "engineering state missing approved Product Contract hash — run alloy-product-handoff"
  fi

  if [[ "$state" == "approved" || "$state" == "remediation_required" ]]; then
    alloy_initiative_transition "$key" "assigning"
  fi

  local staging_sha worker_plan
  staging_sha="$(alloy_staging_sha)"
  worker_plan="$base/plan/worker-plan.yaml"

  # Parse worker plan assignments
  local assignments
  assignments="$(node -e "
    const fs = require('fs');
    const yaml = fs.readFileSync('${worker_plan}','utf8');
    const lines = yaml.split('\\n');
    let cur = null;
    const out = [];
    for (const line of lines) {
      const m = line.match(/^  - task_id: (.+)$/);
      if (m) {
        if (cur) out.push(cur);
        cur = { task_id: m[1].trim().replace(/^['\"]|['\"]$/g, '') };
        continue;
      }
      if (!cur) continue;
      const s = line.match(/^    (?:selected_slot|slot): (\\d+)/); if (s) cur.slot = +s[1];
      const a = line.match(/^    agent: (\\S+)/); if (a) cur.agent = a[1].replace(/^['\"]|['\"]$/g, '');
      const r = line.match(/^    role: \"(.+)\"/); if (r) cur.role = r[1];
      if (!r) { const r2 = line.match(/^    role: (.+)/); if (r2) cur.role = r2[1].trim(); }
    }
    if (cur) out.push(cur);
    console.log(JSON.stringify(out));
  ")"

  local count
  count="$(node -e "console.log(JSON.parse(process.argv[1]).length)" "$assignments")"
  local i=0
  while [[ $i -lt $count ]]; do
    local task_id slot agent role initiative_suffix worktree_name
    task_id="$(node -e "console.log(JSON.parse(process.argv[1])[process.argv[2]].task_id)" "$assignments" "$i")"
    slot="$(node -e "console.log(JSON.parse(process.argv[1])[process.argv[2]].slot)" "$assignments" "$i")"
    agent="$(node -e "console.log(JSON.parse(process.argv[1])[process.argv[2]].agent||'')" "$assignments" "$i")"
    if [[ -z "$agent" ]]; then
      agent="$(alloy_slot_default_agent "$slot")"
    fi
    role="$(node -e "console.log(JSON.parse(process.argv[1])[process.argv[2]].role||'')" "$assignments" "$i")"

  initiative_suffix="${key}-t${task_id#task-}"
    alloy_validate_slot "$slot"

    if alloy_find_metadata_by_slot "$slot" >/dev/null 2>&1; then
      local existing
      existing="$(alloy_find_metadata_by_slot "$slot")"
      local owned
      owned="$(node -e "
        const d = require('${base}/state.json');
        const w = Object.values(d.workers||{});
        process.stdout.write(w.some(x=>x.slot===${slot})?'yes':'');
      ")"
      if [[ "$owned" != "yes" ]]; then
        alloy_die "slot $slot occupied by unrelated worktree: $existing"
      fi
      worktree_name="$existing"
      alloy_load_metadata "$worktree_name"
    else
      if [[ "$dry_run" -eq 1 ]]; then
        alloy_info "[dry-run] would create slot $slot ($agent) for $task_id"
        i=$((i + 1))
        continue
      fi
      alloy_info "Creating worker: slot $slot / $task_id"
      env ALLOY_CONFIG_FILE="${ALLOY_CONFIG_FILE}" \
        "${SCRIPT_DIR}/alloy-agent-create" "$initiative_suffix" "$agent" --slot "$slot"
      worktree_name="$(alloy_worktree_name "$slot" "$initiative_suffix")"
      alloy_load_metadata "$worktree_name"
      alloy_engineering_cost_increment "$key" "workers_used"
    fi

    if [[ "$dry_run" -eq 0 ]]; then
      alloy_engineering_set_worker_assignment "$key" "$task_id" "$slot" \
        "$worktree_name" "$ALLOY_WORKTREE_BRANCH" "$ALLOY_WORKTREE_PATH" "$PORT" "$ALLOY_AGENT" "$role" "$staging_sha"
      env ALLOY_CONFIG_FILE="${ALLOY_CONFIG_FILE}" \
        "${SCRIPT_DIR}/alloy-worker-package" "$key" "$task_id"
      alloy_engineering_update_task_status "$key" "$task_id" "assigned"
    fi
    i=$((i + 1))
  done

  if [[ "$dry_run" -eq 0 ]]; then
    if [[ "$(alloy_initiative_current_state "$key")" == "assigning" ]]; then
      alloy_initiative_transition "$key" "implementing"
    fi
  fi

  alloy_info "Initiative $key — workers prepared"
  alloy_info "  state: $(alloy_initiative_current_state "$key")"
  alloy_info ""
  alloy_info "Deliver packages: alloy-worker-open $key <task-id>"
}

main "$@"
