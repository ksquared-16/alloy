#!/usr/bin/env bash
# Safely remove an Alloy agent worktree and its local branch (non-force).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: alloy-worktree-remove <worktree-name>
       alloy-worktree-remove <worktree-name> --orphaned <expected-branch>

  --orphaned  retire a worktree whose registration is already gone. The branch
              must be named and must match the worktree HEAD, because with no
              metadata there is no recorded branch to check against.

Requires an explicit interactive confirmation.
Uses git worktree remove (never --force) and git branch -d (never -D).
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  local name="" orphan_branch=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      # A WORKTREE WITHOUT METADATA STILL HAS TO BE RETIRABLE.
      #
      # This command loads metadata first and dies "unknown worktree metadata"
      # if it is missing, so a worktree whose registration is gone has NO
      # canonical retirement path and the operator is pushed to raw
      # `git worktree remove`. That is not hypothetical: registration is
      # host-local state that no backup carries (see alloy-worktree-adopt), and
      # a retirement that deletes metadata before calling this command produces
      # exactly the same orphan. It happened during capacity certification.
      #
      # The safety property is NOT the metadata file — it is that we never
      # remove a worktree whose identity we cannot confirm. With no registration
      # there is no recorded branch to compare against, so the caller must NAME
      # the branch and it must match the worktree's actual HEAD. The check is
      # preserved, only its source moves from the registry to the caller.
      --orphaned) orphan_branch="${2:-}"; shift 2 ;;
      -*) usage >&2; exit 2 ;;
      *) name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || { usage >&2; exit 2; }

  alloy_load_config
  alloy_ensure_runtime_dirs
  alloy_require_cmd git
  alloy_verify_canonical_repo

  local path branch port
  if [[ -n "$orphan_branch" ]]; then
    [[ -f "$(alloy_metadata_path "$name")" ]] && \
      alloy_die "$name IS registered — retire it normally; --orphaned is only for a worktree whose metadata is already gone."
    path="${ALLOY_WORKTREE_ROOT}/${name}"
    branch="$orphan_branch"
    port=""
    [[ -d "${path}/.git" || -f "${path}/.git" ]] || \
      alloy_die "not a git worktree: ${path}. No data removed."
  else
    alloy_load_metadata "$name"
    path="$ALLOY_WORKTREE_PATH"
    branch="$ALLOY_WORKTREE_BRANCH"
    port="$PORT"
  fi
  local meta_path pid_path log_path pid
  meta_path="$(alloy_metadata_path "$name")"
  pid_path="$(alloy_pid_path "$name")"
  log_path="$(alloy_log_path "$name")"

  [[ -d "$path" ]] || alloy_die "metadata/path disagree: path missing ($path). No data removed."

  local current
  current="$(alloy_current_branch "$path")"
  [[ "$current" == "$branch" ]] || \
    alloy_die "${orphan_branch:+--orphaned }branch disagree: expected '$branch', found '$current'. No data removed."

  if alloy_worktree_is_dirty "$path"; then
    alloy_die "worktree is dirty; commit or discard changes manually first. No data removed."
  fi

  if [[ -f "$pid_path" ]]; then
    pid="$(alloy_read_pid_file "$pid_path" || true)"
    if [[ -n "${pid:-}" ]] && alloy_pid_alive "$pid"; then
      if alloy_pid_belongs_to_worktree "$pid" "$path"; then
        alloy_die "dev server appears running (PID $pid). Run: alloy-dev-stop $name"
      fi
      alloy_die "PID file exists for live PID $pid that does not clearly belong to this worktree. Inspect manually."
    fi
  fi

  alloy_info "Fetching ${ALLOY_BASE_REMOTE}..."
  alloy_repo_fetch "$ALLOY_REPO"
  local base
  base="$(alloy_base_ref)"

  # Unmerged commits relative to latest origin/staging?
  local ahead
  ahead="$(alloy_git "$path" rev-list --count "${base}..${branch}")"
  if [[ "$ahead" != "0" ]]; then
    cat >&2 <<EOF
error: branch '${branch}' has ${ahead} commit(s) not present in ${base}.

No data was removed.
Merge or otherwise land the work with approval, or keep the worktree.
EOF
    exit 1
  fi

  cat <<EOF
Planned removal:
  worktree: ${name}
  path:     ${path}
  branch:   ${branch}
  port:     ${port}
  metadata: ${meta_path}
  pid file: ${pid_path}
  log file: ${log_path}

Actions:
  1) git worktree remove ${path}   (never --force)
  2) git branch -d ${branch}       (never -D)
  3) remove runtime metadata/logs for this worktree only
EOF

  alloy_confirm "Remove this worktree and delete the local branch if fully merged?"

  alloy_git "$ALLOY_REPO" worktree remove "$path"
  if ! alloy_git "$ALLOY_REPO" branch -d "$branch"; then
    cat >&2 <<EOF
error: git branch -d failed (branch not fully merged from git's perspective).
The worktree directory was removed by git worktree remove, but the branch remains.
Inspect with: git -C ${ALLOY_REPO} branch -vv | grep ${branch}
EOF
    rm -f "$meta_path" "$pid_path"
    # keep log for forensics
    exit 1
  fi

  rm -f "$meta_path" "$pid_path" "$log_path"
  alloy_info "Removed worktree ${name}."
}

main "$@"
