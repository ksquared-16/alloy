#!/usr/bin/env bash
# Start a managed Alloy sprint: slot + worktree + deps + env + optional server + provider.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/agent.sh
source "${SCRIPT_DIR}/lib/agent.sh"
# shellcheck source=lib/sprint-ops.sh
source "${SCRIPT_DIR}/lib/sprint-ops.sh"
# shellcheck source=lib/manifest.sh
source "${SCRIPT_DIR}/lib/manifest.sh"

usage() {
  cat <<'EOF'
Usage: alloy-sprint-start <name> --provider <cursor|claude> [--slot auto|N]
                          [--with-server|--without-server]
                          [--objective <text>] [--dry-run-open]
                          [--stage <discovery|constitution|realization|certification|promotion>]
                          [--role <product-office|engineering-director|worker|certifier|operator>]
                          [--lane <runtime|configuration|ux|documentation|infrastructure>]
                          [--posture <read-only|shared-read-only|isolated-mutable>]
                          [--tenant <shared|disposable|production-like|none>]
                          [--initiative <key>] [--handoff-to <role>]
                          [--promotion-target <ref>]
                          [--constitution <hash> | --no-constitution <reason>]

Starts a managed six-slot sprint worker:
  - selects only an available slot (fail closed if occupied/unhealthy)
  - fetches origin/staging and creates the managed branch/worktree
  - preserves permanent slot→port mapping (3011–3016)
  - installs worktree-local dependencies (never symlinks node_modules)
  - prepares managed env and validates repository boundaries
  - starts localhost only with --with-server (default: without)
  - writes the sprint manifest (stage, role, lane, posture, basis, handoff,
    certification ceiling, promotion target, canonical root) so no prompt has to
    restate them
  - generates worker instructions + readiness summary
  - opens the chosen provider on the exact worktree

Undeclared fields are recorded as 'undeclared' and warned about. Set
ALLOY_SPRINT_REQUIRE_MANIFEST=1 to refuse an incomplete manifest instead.

Examples:
  alloy-sprint-start queue-perf --provider cursor
  alloy-sprint-start queue-perf --provider claude --slot 3 --with-server
  alloy-sprint-start m7-cert --provider claude --stage certification \
      --role certifier --posture isolated-mutable --tenant disposable
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  local name="" provider="" slot="auto" with_server=0 objective="" dry_open=0
  local stage="undeclared" role="undeclared" lane="undeclared"
  local posture="undeclared" tenant="undeclared"
  local initiative_key="null" handoff_to="undeclared" promotion_target="undeclared"
  local basis_type="undeclared" basis_value="null" basis_reason="null"
  local -a positional=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider)
        [[ $# -ge 2 ]] || alloy_die "--provider requires cursor|claude"
        provider="$2"
        shift 2
        ;;
      --provider=*)
        provider="${1#--provider=}"
        shift
        ;;
      --slot)
        [[ $# -ge 2 ]] || alloy_die "--slot requires auto|N"
        slot="$2"
        shift 2
        ;;
      --slot=*)
        slot="${1#--slot=}"
        shift
        ;;
      --with-server)
        with_server=1
        shift
        ;;
      --without-server)
        with_server=0
        shift
        ;;
      --objective)
        [[ $# -ge 2 ]] || alloy_die "--objective requires text"
        objective="$2"
        shift 2
        ;;
      --objective=*)
        objective="${1#--objective=}"
        shift
        ;;
      --dry-run-open)
        dry_open=1
        shift
        ;;
      --stage) stage="${2:?--stage requires a value}"; shift 2 ;;
      --stage=*) stage="${1#--stage=}"; shift ;;
      --role) role="${2:?--role requires a value}"; shift 2 ;;
      --role=*) role="${1#--role=}"; shift ;;
      --lane) lane="${2:?--lane requires a value}"; shift 2 ;;
      --lane=*) lane="${1#--lane=}"; shift ;;
      --posture) posture="${2:?--posture requires a value}"; shift 2 ;;
      --posture=*) posture="${1#--posture=}"; shift ;;
      --tenant) tenant="${2:?--tenant requires a value}"; shift 2 ;;
      --tenant=*) tenant="${1#--tenant=}"; shift ;;
      --initiative) initiative_key="${2:?--initiative requires a key}"; shift 2 ;;
      --initiative=*) initiative_key="${1#--initiative=}"; shift ;;
      --handoff-to) handoff_to="${2:?--handoff-to requires a role}"; shift 2 ;;
      --handoff-to=*) handoff_to="${1#--handoff-to=}"; shift ;;
      --promotion-target) promotion_target="${2:?--promotion-target requires a ref}"; shift 2 ;;
      --promotion-target=*) promotion_target="${1#--promotion-target=}"; shift ;;
      --constitution) basis_type="contract-hash"; basis_value="${2:?--constitution requires a hash}"; shift 2 ;;
      --constitution=*) basis_type="contract-hash"; basis_value="${1#--constitution=}"; shift ;;
      --no-constitution) basis_type="declared-absent"; basis_reason="${2:?--no-constitution requires a reason}"; shift 2 ;;
      --no-constitution=*) basis_type="declared-absent"; basis_reason="${1#--no-constitution=}"; shift ;;
      -h|--help)
        usage
        exit 0
        ;;
      --*)
        alloy_die "unknown option: $1"
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  [[ ${#positional[@]} -eq 1 ]] || { usage >&2; exit 2; }
  name="${positional[0]}"
  [[ -n "$provider" ]] || alloy_die "--provider <cursor|claude> is required"

  alloy_load_config
  alloy_ensure_sprint_ops_dirs
  alloy_sprint_ops_defaults
  # shellcheck source=lib/verify.sh
  source "${SCRIPT_DIR}/lib/verify.sh"
  alloy_ensure_verify_runtime_dirs
  ALLOY_LOCAL_DEV_ROOT="$SCRIPT_DIR"
  alloy_require_cmd git
  alloy_validate_initiative "$name"
  alloy_validate_agent "$provider"
  alloy_verify_canonical_repo

  local resolved_slot
  if [[ "$slot" == "auto" || -z "$slot" ]]; then
    resolved_slot="$(alloy_find_first_free_slot)" || \
      alloy_die "no free slots (1-${ALLOY_MAX_AGENTS} all assigned). Fail closed."
  else
    alloy_validate_slot "$slot"
    alloy_refuse_unhealthy_slot_assignment "$slot"
    resolved_slot="$slot"
  fi

  # Fail closed if chosen free slot's permanent port is already taken.
  local port
  port="$(alloy_slot_to_port "$resolved_slot")"
  alloy_refuse_occupied_port "$port" "sprint-start slot ${resolved_slot}"

  alloy_info "Starting sprint '${name}' on slot ${resolved_slot} → port ${port} (${provider})"

  # Create via existing Phase 2 primitive (do not duplicate worktree creation).
  env ALLOY_CONFIG_FILE="${ALLOY_CONFIG_FILE}" \
    "${SCRIPT_DIR}/alloy-agent-create" "$name" "$provider" --slot "$resolved_slot"

  local wt_name
  wt_name="$(alloy_worktree_name "$resolved_slot" "$name")"
  alloy_load_metadata "$wt_name"
  alloy_validate_worktree_boundary "$ALLOY_WORKTREE_PATH"

  # Fail closed if create left us dirty in unexpected ways (should be clean).
  local dirty_class
  dirty_class="$(alloy_worktree_dirty_classification "$ALLOY_WORKTREE_PATH")"
  if [[ "$dirty_class" == "dirty" ]]; then
    alloy_die "newly created worktree is dirty — fail closed: $ALLOY_WORKTREE_PATH"
  fi

  alloy_set_sprint_fields "$wt_name" "$name" "$objective"
  alloy_set_worker_lifecycle "$wt_name" "active"
  alloy_load_metadata "$wt_name"

  # The Sprint Manifest. Written before deps, env, or the provider, because it is
  # what every later step and every future reader consults instead of a prompt.
  alloy_require_cmd node
  alloy_manifest_init "$wt_name" "$resolved_slot"
  alloy_manifest_set "$wt_name" \
    "sprint_name=${name}" \
    "objective=${objective}" \
    "stage=${stage}" \
    "role=${role}" \
    "lane=${lane}" \
    "posture.mutation=${posture}" \
    "posture.tenant_class=${tenant}" \
    "initiative_key=${initiative_key}" \
    "handoff_target=${handoff_to}" \
    "promotion.target=${promotion_target}" \
    "constitutional_basis.type=${basis_type}" \
    "constitutional_basis.value=${basis_value}" \
    "constitutional_basis.reason=${basis_reason}"
  alloy_manifest_record_root "$wt_name"
  alloy_manifest_append_history "$wt_name" "sprint-start" "slot ${resolved_slot} provider ${provider}"
  alloy_manifest_enforce_or_warn "$wt_name"

  # Integration-debt gate. Surfaced HERE, before dependencies and implementation
  # are layered onto a stale base — >=50 behind warns, >=100 blocks until a
  # reconciliation decision is recorded. Cheap to act on now, expensive later.
  local debt_evidence
  if ! debt_evidence="$(alloy_assert_integration_debt_acceptable "$ALLOY_WORKTREE_PATH" "$wt_name")"; then
    printf '%s\n' "$debt_evidence" | sed 's/^/  /'
    alloy_die "sprint start blocked: integration debt exceeds the block threshold (see above)"
  fi
  printf '%s\n' "$debt_evidence" | sed 's/^/  /'

  # The toolkit must not be owned by a worker worktree, or deleting a slot
  # breaks every alloy-* command on the machine.
  alloy_durability_toolkit_not_in_worktree >/dev/null || \
    alloy_warn "toolkit resolves through a worktree — run: alloy-toolkit install origin/staging"

  alloy_sprint_install_deps "$ALLOY_WORKTREE_PATH" "$wt_name"

  # Prepare managed env (auth paths remain optional until login).
  env ALLOY_CONFIG_FILE="${ALLOY_CONFIG_FILE}" \
    "${SCRIPT_DIR}/alloy-agent-prepare" "$wt_name" || \
    alloy_warn "alloy-agent-prepare reported issues — continuing with readiness summary"

  # Regenerate instructions after sprint fields set.
  alloy_load_metadata "$wt_name"
  local instructions
  instructions="$(alloy_generate_agent_instructions "$wt_name")"
  alloy_augment_metadata_agent_fields "$wt_name" \
    "${ALLOY_AGENT_ROLE:-$(alloy_slot_role "$resolved_slot")}" \
    "active" \
    "$instructions"
  # Preserve sprint fields after augment (augment historically drops them).
  alloy_load_metadata "$wt_name"
  alloy_set_sprint_fields "$wt_name" "$name" "$objective"
  alloy_set_worker_lifecycle "$wt_name" "active"
  alloy_load_metadata "$wt_name"

  if [[ "$with_server" -eq 1 ]]; then
    alloy_guard_server_start "$wt_name"
    env ALLOY_CONFIG_FILE="${ALLOY_CONFIG_FILE}" \
      "${SCRIPT_DIR}/alloy-dev-start" "$wt_name"
  else
    alloy_info "Server not started (--without-server). Use alloy-dev-start ${wt_name} when needed."
  fi

  alloy_print_readiness_summary "$wt_name"

  if [[ "$dry_open" -eq 1 ]]; then
    export ALLOY_AGENT_OPEN_DRY_RUN=1
  fi
  alloy_guard_provider_start "$wt_name"
  alloy_open_tool_for_agent "$provider" "$ALLOY_WORKTREE_PATH"
  if [[ "${ALLOY_AGENT_OPEN_DRY_RUN:-0}" != "1" ]]; then
    local launch_pid
    launch_pid="$(pgrep -n -f "${ALLOY_WORKTREE_PATH}" 2>/dev/null | head -1 || true)"
    if [[ -n "$launch_pid" ]]; then
      alloy_register_provider_pid "$wt_name" "$launch_pid" "$ALLOY_WORKTREE_PATH" ""
    fi
  fi

  cat <<EOF
Sprint started
  name:     ${name}
  slot:     ${resolved_slot}
  provider: ${provider}
  worktree: ${wt_name}
  path:     ${ALLOY_WORKTREE_PATH}
  port:     ${port}
  server:   $(alloy_server_state_for "$wt_name")

Root:     ${ALLOY_REPO} (canonical) — alloy-root
$(alloy_manifest_card "$wt_name" | sed 's/^/  /')

Overnight:
  alloy-worker-pause ${resolved_slot}
Morning:
  alloy-worker-resume ${resolved_slot}
Status:
  alloy-worker-status
Finish:
  alloy-sprint-finish ${resolved_slot}
EOF
}

main "$@"
