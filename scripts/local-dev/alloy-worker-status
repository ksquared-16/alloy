#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/engineering.sh
source "${SCRIPT_DIR}/lib/engineering.sh"
# shellcheck source=lib/agent.sh
source "${SCRIPT_DIR}/lib/agent.sh"

usage() {
  cat <<'EOF'
Usage:
  alloy-worker-status <initiative-key> [task-id]

Shows worker assignment, worktree git state, package presence, and report status.
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then usage; exit 0; fi
  [[ $# -ge 1 ]] || { usage >&2; exit 2; }

  local key="$1" filter_task="${2:-}"
  alloy_load_config
  alloy_initiative_exists "$key" || alloy_die "initiative not found: $key"

  local base
  base="$(alloy_initiative_dir "$key")"

  show_task() {
    local task_id="$1"
    local w
    w="$(node -e "
      const w = require('${base}/state.json').workers['${task_id}'];
      if (!w) process.exit(1);
      console.log(JSON.stringify(w));
    " 2>/dev/null)" || { alloy_info "  $task_id: (unassigned)"; return; }

    local name path pkg report task_status
    name="$(node -e "console.log(JSON.parse(process.argv[1]).worktree_name)" "$w")"
    path="$(node -e "console.log(JSON.parse(process.argv[1]).path)" "$w")"
    task_status="$(alloy_engineering_task_status "$(alloy_engineering_task_path "$key" "$task_id")")"
    pkg="missing"
    [[ -f "$(alloy_engineering_worker_package_md_path "$path")" ]] && pkg="present"
    report="missing"
    [[ -f "$(alloy_engineering_report_path "$key" "$task_id")" ]] && report="present"

    printf 'Task %s\n' "$task_id"
    printf '  status:   %s\n' "$task_status"
    printf '  slot:     %s\n' "$(node -e "console.log(JSON.parse(process.argv[1]).slot)" "$w")"
    printf '  role:     %s\n' "$(node -e "console.log(JSON.parse(process.argv[1]).role)" "$w")"
    printf '  worktree: %s\n' "$name"
    printf '  package:  %s\n' "$pkg"
    printf '  report:   %s\n' "$report"
    if [[ -d "$path" ]]; then
      printf '  git:      %s\n' "$(alloy_git_state_summary "$path")"
    fi
    echo
  }

  if [[ -n "$filter_task" ]]; then
    show_task "$filter_task"
  else
    local tid
    for tid in $(alloy_engineering_list_tasks "$key"); do
      show_task "$tid"
    done
  fi
}

main "$@"
