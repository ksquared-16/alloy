#!/usr/bin/env bash
# Ready check for managed agent verification bootstrap.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/agent.sh
source "${SCRIPT_DIR}/lib/agent.sh"
# shellcheck source=lib/verify.sh
source "${SCRIPT_DIR}/lib/verify.sh"

usage() {
  cat <<'EOF'
Usage: alloy-agent-ready <slot|name>

Reports READY or NOT READY with remediation for git, server, env, auth, browser, context.
EOF
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }

  alloy_load_config
  alloy_ensure_verify_runtime_dirs
  ALLOY_LOCAL_DEV_ROOT="$SCRIPT_DIR"

  local name
  name="$(alloy_resolve_worktree_name "$1")"

  local eval_out status branch ahead behind server ownership auth browser lock
  eval_out="$(alloy_agent_ready_evaluate "$name")"
  status="$(printf '%s\n' "$eval_out" | awk -F= '/^READY_STATUS=/{print $2}')"
  branch="$(printf '%s\n' "$eval_out" | awk -F= '/^GIT_BRANCH=/{print $2}')"
  ahead="$(printf '%s\n' "$eval_out" | awk -F= '/^GIT_AHEAD=/{print $2}')"
  behind="$(printf '%s\n' "$eval_out" | awk -F= '/^GIT_BEHIND=/{print $2}')"
  server="$(printf '%s\n' "$eval_out" | awk -F= '/^SERVER=/{print $2}')"
  ownership="$(printf '%s\n' "$eval_out" | awk -F= '/^SERVER_OWNERSHIP=/{print $2}')"
  auth="$(printf '%s\n' "$eval_out" | awk -F= '/^AUTH=/{print $2}')"
  browser="$(printf '%s\n' "$eval_out" | awk -F= '/^BROWSER=/{print $2}')"
  lock="$(printf '%s\n' "$eval_out" | awk -F= '/^VALIDATION_LOCK=/{print $2}')"

  alloy_load_metadata "$name"
  local slot="$ALLOY_WORKTREE_SLOT"
  local staging_sha
  staging_sha="$(alloy_git "$ALLOY_REPO" rev-parse "${ALLOY_BASE_REMOTE}/${ALLOY_BASE_BRANCH}" 2>/dev/null || echo unknown)"

  local agent_env_mode trusted_source
  agent_env_mode="missing"
  if alloy_agent_env_ready "$ALLOY_WORKTREE_PATH"; then
    agent_env_mode="600"
  elif [[ -f "$(alloy_agent_web_env_path "$ALLOY_WORKTREE_PATH")" ]]; then
    agent_env_mode="wrong-permissions"
  fi
  trusted_source="$(alloy_server_env_source_path)"

  echo "Agent ready check — ${name} (slot ${slot})"
  echo "Result: ${status} (L1: slot bootstrapped) — CAN WORK BEGIN?"
  echo
  # A verdict names the level it reached and never implies a level it did not
  # test. READY answers "can work begin"; NOTHING here answers "would CI pass" --
  # this command's overlap with CI is empty, not partial. Nine deliverables were
  # reported "lint green" from a non-blocking local variant while CI's blocking
  # mode had caught a defect, because the toolkit offered no signal that a local
  # check and its CI counterpart differ. It offers one now.
  echo "NOT checked here: typecheck, tests, lint, build, docs-lint."
  echo "  READY   = can work begin?        <- this command (env, auth, server, branch)"
  echo "  GATE    = would CI likely pass?  <- alloy-validate typecheck|test|build|imports"
  echo "  CERTIFY = can this be promoted?  <- evidence at a level; L5 never self-issued"
  echo "Independent questions. READY is not a fitness verdict."
  echo
  echo "Git"
  echo "  branch:        ${branch} (expected ${ALLOY_WORKTREE_BRANCH})"
  echo "  ahead/behind:  ${ahead}/${behind} vs $(alloy_base_ref_status)"
  echo "  staging SHA:   ${staging_sha}"
  echo
  echo "Application"
  echo "  port:          ${PORT}"
  echo "  server:        ${server}"
  echo "  ownership:     ${ownership} (alloy-dev-start required; not npm run dev)"
  echo "  url:           ${NEXT_PUBLIC_APP_URL:-http://localhost:${PORT}}"
  echo
  echo "Environment"
  echo "  agent-safe env:     $([[ -f "$(alloy_agent_web_env_path "$ALLOY_WORKTREE_PATH")" ]] && echo present || echo missing) (web/.env.local.agent)"
  echo "  agent-safe perms:   ${agent_env_mode}"
  echo "  trusted source:     $([[ -f "$trusted_source" ]] && echo configured || echo missing) (${trusted_source})"
  local req_ok=() req_miss=()
  local rn
  while IFS= read -r rn; do
    [[ -n "$rn" ]] || continue
    if [[ -f "$trusted_source" ]] && alloy_env_file_has_nonempty "$trusted_source" "$rn"; then
      req_ok+=("$rn")
    else
      req_miss+=("$rn")
    fi
  done < <(alloy_required_server_env_names)
  echo "  required server:    present=[${req_ok[*]:-}] missing=[${req_miss[*]:-}]"
  if alloy_agent_env_ready "$ALLOY_WORKTREE_PATH" && alloy_agent_env_lacks_privileged "$ALLOY_WORKTREE_PATH"; then
    echo "  trusted in worktree: no (privileged names absent from agent-safe file)"
  elif [[ -f "$(alloy_agent_web_env_path "$ALLOY_WORKTREE_PATH")" ]]; then
    echo "  trusted in worktree: YES — privileged names leaked into agent-safe file"
  else
    echo "  trusted in worktree: n/a"
  fi
  echo "  env loading:        alloy-dev-start only (agent-safe + trusted injection; not npm run dev)"
  echo
  echo "Authentication"
  echo "  QA identity:   $(alloy_slot_qa_identity "$slot")"
  echo "  storage:       $(alloy_auth_storage_path "$slot")"
  echo "  auth state:    ${auth}"
  echo
  echo "Browser"
  echo "  owned browser: ${browser}"
  echo "  profile:       $(alloy_browser_profile_dir "$slot")"
  echo
  echo "Validation lock: ${lock}"

  local issues
  issues="$(printf '%s\n' "$eval_out" | awk -F= '/^ISSUE=/{print $2}')"
  if [[ -n "$issues" ]]; then
    echo
    echo "Remediation"
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      echo "  - $line"
    done <<<"$issues"
  fi

  [[ "$status" == "READY" ]]
}

main "$@"
