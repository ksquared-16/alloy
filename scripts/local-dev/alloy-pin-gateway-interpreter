#!/usr/bin/env bash
# =============================================================================
# alloy-pin-gateway-interpreter — make the Gateway's Node identity stated rather
# than inherited.
#
# THE DEFECT. The launchd plist names /opt/homebrew/bin/node. That path belongs
# to whichever node formula Homebrew has linked, so installing the unversioned
# `node` formula silently repoints it at a different MAJOR — and the Gateway
# picks that up at its next restart without anything asking. A maintenance
# reboot is exactly when that happens.
#
# WHY NOT THE EXACT CELLAR PATH. /opt/homebrew/Cellar/node@22/22.23.2_1/bin/node
# is precise and is removed by `brew cleanup`. Pinning there converts a silent
# version change into a Gateway that cannot start at all, which is a worse
# failure in the direction of downtime.
#
# WHAT THIS USES. /opt/homebrew/opt/node@<major>/bin/node — the formula link.
# Bound to the major that was certified, following patch upgrades inside it, and
# surviving cleanup. The residual drift (a patch bump within the major) is then
# CAUGHT rather than prevented, by certifying the running process.version after
# boot.
#
# It rewrites one plist value. It does not restart the Gateway: a restart during
# an authoritative soak is exactly what must not happen, so reloading is a
# separate, deliberate operator step.
# =============================================================================
set -euo pipefail

PLIST="${ALLOY_GATEWAY_PLIST:-$HOME/Library/LaunchAgents/com.alloy.vacilando-gateway.plist}"
MAJOR="${ALLOY_GATEWAY_NODE_MAJOR:-22}"
PINNED="/opt/homebrew/opt/node@${MAJOR}/bin/node"

current_interpreter() {
  /usr/libexec/PlistBuddy -c "Print :ProgramArguments:0" "$PLIST" 2>/dev/null || true
}

case "${1:-}" in
  --status)
    cur="$(current_interpreter)"
    printf 'plist       %s\n' "$PLIST"
    printf 'interpreter %s\n' "${cur:-<unreadable>}"
    printf 'pinned      %s\n' "$PINNED"
    if [[ "$cur" == "$PINNED" ]]; then
      printf 'state       PINNED\n'; exit 0
    fi
    printf 'state       NOT PINNED — a node major upgrade would change the Gateway interpreter at its next restart\n'
    exit 1
    ;;
  --revert)
    /usr/libexec/PlistBuddy -c "Set :ProgramArguments:0 /opt/homebrew/bin/node" "$PLIST"
    echo "reverted to /opt/homebrew/bin/node (unpinned)"
    exit 0
    ;;
esac

[[ -x "$PINNED" ]] || { echo "refusing: $PINNED does not exist or is not executable" >&2; exit 1; }
[[ -f "$PLIST" ]] || { echo "refusing: $PLIST not found" >&2; exit 1; }

# Record what is being certified, so post-boot can compare against a value rather
# than against an assumption.
VERSION="$("$PINNED" --version)"
/usr/libexec/PlistBuddy -c "Set :ProgramArguments:0 ${PINNED}" "$PLIST"

echo "interpreter pinned: ${PINNED} (${VERSION})"
echo "certified Node identity: ${VERSION}"
echo
echo "The Gateway was NOT restarted. It keeps running its current interpreter until"
echo "launchd next starts it; post-boot certification compares the running"
echo "process.version against the certified identity and constrains on a mismatch."
