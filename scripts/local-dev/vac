#!/usr/bin/env bash
# vac — short UX alias for the host-wide validation broker + worker protocol.
#   vac run typecheck|typecheck:tests|test|build|playwright|imports [--force]
#   vac run-status <run_id> <state> [...]
#   vac run-report <run_id> <type> --message-file <path|-> [...]
#   vac governed-action --run <id> --lane <lane> --json '{...}'
  vac governed-dependency --run <id> --lane <lane> --json '{...}'
                           Declare what capability is required. Vacilando
                           decides where it executes; you may not.
#   vac governed-dependency --run <id> --lane <lane> --json '{...}'
#   vac status
#   vac cancel <request_id>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  vac run <kind> [--force]     Run a heavy validation kind in this worktree (brokered)
  vac run-status <run_id> <state>   Report Execution Run state (not the validation broker)
  vac checkpoint-create <run_id>    Commit ONLY the named paths (never a broad add)
  vac certify-fixture <name> <op>   Run an allowlisted certification fixture (credentials stay trusted)
  vac browser-auth <status|sign-in> Recover a lane's browser session (you sign in; the agent cannot)
  vac health [--json|--check N]     Host and Vacilando runtime health (read-only)
  vac run-report <run_id> <type> --message-file <path|->
                           Submit the user-facing agent report that IS the
                           conversation: progress | needs-input | completion | failure
  vac governed-action --run <id> --lane <lane> --json '{...}'
                           Report a Director-owned governed action (not the validation broker)
  vac status                   Show active lease + FIFO queue
  vac cancel <request_id>      Cancel a waiter or signal the holder

Kinds: typecheck | typecheck:tests | test | build | playwright | imports

Focused Vitest stays direct (not brokered):
  npx vitest run path/to/file.test.ts
EOF
}

case "${1:-}" in
  -h|--help|"") usage; exit 0 ;;
  status) exec "$SCRIPT_DIR/alloy-validate" status ;;
  cancel)
    shift
    exec "$SCRIPT_DIR/alloy-validate" cancel "$@"
    ;;
  run-status)
    shift
    exec node "$SCRIPT_DIR/vac-run-status.mjs" "$@"
    ;;
  run-report)
    shift
    exec node "$SCRIPT_DIR/vac-run-report.mjs" "$@"
    ;;
  checkpoint-create)
    shift
    exec node "$SCRIPT_DIR/vac-checkpoint-create.mjs" "$@"
    ;;
  certify-fixture)
    shift
    exec node "$SCRIPT_DIR/vac-certify-fixture.mjs" "$@"
    ;;
  health)
    shift
    exec node "$SCRIPT_DIR/vac-health.mjs" "$@"
    ;;
  browser-auth)
    shift
    exec node "$SCRIPT_DIR/vac-browser-auth.mjs" "$@"
    ;;
  governed-action)
    shift
    exec node "$SCRIPT_DIR/vac-governed-action.mjs" "$@"
    ;;
  governed-dependency)
    shift
    exec node "$SCRIPT_DIR/vac-governed-dependency.mjs" "$@"
    ;;
  run)
    shift
    exec "$SCRIPT_DIR/vac-run" "$@"
    ;;
  *)
    # Convenience: `vac typecheck` == `vac run typecheck`
    exec "$SCRIPT_DIR/vac-run" "$@"
    ;;
esac
