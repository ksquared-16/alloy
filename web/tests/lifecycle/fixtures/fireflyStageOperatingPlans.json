         },
         {
          "value": "schedule_mismatch",
          "label": "Schedule did not fit"
         },
         {
          "value": "cost",
          "label": "Cost"
         },
         {
          "value": "no_longer_needed",
          "label": "No longer needs care"
         }
        ],
        "binds_to_target_field": "close_reason_key"
       }
      ]
     }
    ]
   }
