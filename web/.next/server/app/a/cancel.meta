{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/a/layout,_N_T_/a/cancel/layout,_N_T_/a/cancel/page,_N_T_/a/cancel"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/a/cancel/__PAGE__",
    "/a/cancel",
    "/a",
    "/_index",
    "/_head"
  ]
}