{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/gutters/layout,_N_T_/gutters/page,_N_T_/gutters"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/gutters/__PAGE__",
    "/gutters",
    "/_index",
    "/_head"
  ]
}