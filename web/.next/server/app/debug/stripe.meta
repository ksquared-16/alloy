{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/debug/layout,_N_T_/debug/stripe/layout,_N_T_/debug/stripe/page,_N_T_/debug/stripe"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/debug/stripe/__PAGE__",
    "/debug/stripe",
    "/debug",
    "/_index",
    "/_head"
  ]
}